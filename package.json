{
  "name": "cw-utaheiland",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:template": "chmod +x ../cw-tprintzi/_template/merge-dirs.sh && ../cw-tprintzi/_template/merge-dirs.sh ../cw-tprintzi/app ./app-overrides ./app",
    "build": "react-router build",
    "refresh": "rm -rf node_modules || true && rm package-lock.json || true && npm install && brew install imagemagick && brew install redis",
    "redis:start": "  brew services start   redis",
    "redis:restart": "brew services restart redis",
    "redis:stop": "   brew services stop    redis",
    "favicons": "chmod +x app/lib/scripts/create-favicons.sh && app/lib/scripts/create-favicons.sh",
    "dev": "NODE_OPTIONS='--import ./instrument.server.mjs' npm run redis:start && react-router dev",
    "start": "NODE_ENV=production NODE_OPTIONS='--import ./instrument.server.mjs' react-router-serve ./build/server/index.js",
    "badges": "chmod +x app/lib/scripts/badge-cloc.sh && app/lib/scripts/badge-cloc.sh && chmod +x app/lib/scripts/badge-version.sh && app/lib/scripts/badge-version.sh",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@apollo/client": "^4.1.6",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.8",
    "@mui/lab": "^7.0.1-beta.23",
    "@mui/material": "^7.3.8",
    "@react-router/dev": "7.12.0",
    "@react-router/node": "7.12.0",
    "@react-router/serve": "7.12.0",
    "@sentry/react-router": "^10.46.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.13.0",
    "i18next": "^25.8.13",
    "i18next-http-backend": "^3.0.2",
    "isbot": "^5.1.31",
    "lodash": "^4.17.23",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.4",
    "react-icons": "^5.6.0",
    "react-masonry-css": "^1.0.16",
    "react-router": "7.12.0",
    "react-youtube": "^10.1.0",
    "redis": "^5.11.0",
    "yet-another-react-lightbox": "^3.29.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@sentry/vite-plugin": "^5.1.1",
    "@tailwindcss/vite": "^4.1.13",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/youtube": "^0.1.2",
    "eslint": "^9.39.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^2.4.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.1.7",
    "vite-plugin-run": "^0.6.1",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
